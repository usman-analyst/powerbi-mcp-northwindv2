{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.0.0/schema.json",
  "name": "revenue_by_category",
  "position": {
    "x": 20,
    "y": 140,
    "z": 1000,
    "height": 260,
    "width": 460,
    "tabOrder": 3
  },
  "visual": {
    "visualType": "donutChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "categories"
                    }
                  },
                  "Property": "categoryName"
                }
              },
              "queryRef": "categories.categoryName",
              "active": true
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Measures"
                    }
                  },
                  "Property": "Total Revenue"
                }
              },
              "queryRef": "_Measures.Total Revenue",
              "active": true
            }
          ]
        }
      }
    }
  }
}