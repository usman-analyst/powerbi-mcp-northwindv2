{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visual/1.2.0/schema.json",
  "name": "revenue_card",
  "position": {
    "x": 0,
    "y": 0,
    "z": 0,
    "height": 120,
    "width": 240,
    "tabOrder": 0
  },
  "visual": {
    "visualType": "card",
    "query": {
      "queryState": {
        "Values": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Measures"
                    }
                  },
                  "Property": "Total Revenue"
                }
              },
              "queryRef": "Measures.Total Revenue"
            }
          ]
        }
      }
    },
    "objects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Total Revenue'"
                }
              }
            }
          }
        }
      ]
    }
  },
  "accessibility": {
    "altText": "KPI card showing total net revenue"
  }
}
