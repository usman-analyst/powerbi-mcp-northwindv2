		summarizeBy: none
		isNameInferred
		sourceColumn: [QuarterSort]

	partition DimDate = calculated
		mode: import
		source =
				VAR StartDate = DATE(2013, 7, 4)
				VAR EndDate = DATE(2015, 12, 31)
				RETURN
				ADDCOLUMNS(
				    CALENDAR(StartDate, EndDate),
				    "Year",                YEAR([Date]),
				    "Quarter",             "Q" & QUARTER([Date]),
				    "QuarterNumber",       QUARTER([Date]),
				    "MonthNumber",         MONTH([Date]),
				    "MonthName",           FORMAT([Date], "MMMM"),
				    "MonthShort",          FORMAT([Date], "MMM"),
				    "MonthYearLabel",      FORMAT([Date], "MMM YYYY"),
				    "WeekNumber",          WEEKNUM([Date], 2),
				    "DayOfMonth",          DAY([Date]),
				    "DayOfWeekNumber",     WEEKDAY([Date], 2),
				    "DayName",             FORMAT([Date], "DDDD"),
				    "IsWeekend",           IF(WEEKDAY([Date], 2) >= 6, TRUE, FALSE),
				    "FiscalYear",          IF(MONTH([Date]) >= 7, YEAR([Date]) + 1, YEAR([Date])),
				    "FiscalQuarter",       "Q" & SWITCH(TRUE,
				                               MONTH([Date]) IN {7,8,9},   1,
				                               MONTH([Date]) IN {10,11,12}, 2,
				                               MONTH([Date]) IN {1,2,3},   3,
				                               4),
				    "MonthSort",           YEAR([Date]) * 100 + MONTH([Date]),
				    "QuarterSort",         YEAR([Date]) * 10 + QUARTER([Date])
				)

