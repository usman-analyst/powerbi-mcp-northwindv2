		isNameInferred
		sourceColumn: [DayName]

	column DayNameShort
		lineageTag: e6a4d962-9698-44ce-b0c3-f7cbfa107e09
		isNameInferred
		sourceColumn: [DayNameShort]

	column WeekNumber
		lineageTag: 8cf8c72e-47fb-40ae-9584-5d5b382d7867
