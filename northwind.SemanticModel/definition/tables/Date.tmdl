	column IsWeekend
		lineageTag: bd5340f9-6f10-4ff2-8538-8f72d707f44a
		isNameInferred
		sourceColumn: [IsWeekend]

	partition Date = calculated
		mode: import
		source =
				ADDCOLUMNS(
				    CALENDAR(DATE(2013, 7, 4), DATE(2015, 5, 6)),
				    "Year", YEAR([Date]),
				    "Quarter", "Q" & QUARTER([Date]),
				    "QuarterNumber", QUARTER([Date]),
				    "Month", MONTH([Date]),
				    "MonthName", FORMAT([Date], "MMMM"),
				    "MonthShort", FORMAT([Date], "MMM"),
				    "MonthYear", FORMAT([Date], "MMM YYYY"),
				    "Day", DAY([Date]),
				    "DayOfWeek", WEEKDAY([Date], 2),
				    "DayName", FORMAT([Date], "DDDD"),
				    "DayNameShort", FORMAT([Date], "DDD"),
				    "WeekNumber", WEEKNUM([Date], 2),
				    "YearMonth", YEAR([Date]) * 100 + MONTH([Date]),
				    "YearQuarter", YEAR([Date]) * 10 + QUARTER([Date]),
				    "IsWeekend", IF(WEEKDAY([Date], 2) >= 6, TRUE, FALSE)
				)

