	/// The country where the employee is located. Useful for regional headcount and performance reporting.
	column country
		dataType: string
		lineageTag: ddcd4ec2-2551-46e3-b714-bfae75a2621b
		summarizeBy: none
		sourceColumn: country

		annotation SummarizationSetBy = Automatic

	/// The employeeID of this person's direct manager. Used to represent the organisational hierarchy and reporting structure.
	column reportsTo
		dataType: string
		lineageTag: 9c1bd7df-b009-416c-a623-c674d54c0ff6
		summarizeBy: none
		sourceColumn: reportsTo

		annotation SummarizationSetBy = Automatic

	partition employees = m
		mode: import
		source =
