table employees
	lineageTag: 27f5da39-3974-4c18-b2d9-8f36aa40eacd

	/// Unique identifier for each employee. Referenced by the orders table to attribute sales to individual staff members.
	column employeeID
		dataType: int64
		lineageTag: 23d565f3-d73e-4b32-a9bf-f71c08b74d3c
		summarizeBy: none
		sourceColumn: employeeID

		annotation SummarizationSetBy = Automatic

	/// The full name of the employee, used for display in reports and employee performance visuals.
	column employeeName
		dataType: string
		lineageTag: 3f68ed89-f686-4e0e-afb2-34d8de7305ef
		summarizeBy: none
		sourceColumn: employeeName

		annotation SummarizationSetBy = Automatic

	/// The employee's job title, such as Sales Representative or Vice President of Sales.
	column title
		dataType: string
		lineageTag: 921a4c7c-9440-4766-94cf-ccee055a2326
		summarizeBy: none
		sourceColumn: title

		annotation SummarizationSetBy = Automatic

	/// The city where the employee is based or works from.
	column city
		dataType: string
		lineageTag: f1fe6bd6-ffc1-4ed2-a797-713db3fe3049
		summarizeBy: none
		sourceColumn: city

