model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-IN
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["orders","categories","customers","employees","order_details","products","shippers"]

annotation PBI_ProTooling = ["MCP-PBIModeling","DevMode"]

ref table orders
ref table categories
ref table customers
ref table employees
ref table order_details
ref table products
ref table shippers
ref table Date
ref table DimDate
ref table _Measures

ref cultureInfo en-US

